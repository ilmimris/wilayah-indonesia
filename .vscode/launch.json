    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api",
            "buildFlags": [
                "-tags",
                "no_duckdb_arrow"
            ],
            "env": {
                "DB_PATH": "${workspaceFolder}/data/regions.duckdb",
                "MATCHER_SNAPSHOT_PATH": "${workspaceFolder}/data/matcher_snapshot.json"
            }
        }
    ]
}
